    { "from": "approval", "to": "cancelled", "variant": "security", "route": "straight", "fromSide": "bottom", "toSide": "top" },
    { "from": "reconciling", "to": "compensating", "variant": "emphasis", "route": "straight", "fromSide": "bottom", "toSide": "top" },
    { "from": "compensating", "to": "compensated", "variant": "emphasis", "route": "straight", "fromSide": "bottom", "toSide": "top" },
    { "from": "succeeded", "to": "manual", "variant": "dashed", "route": "straight", "fromSide": "bottom", "toSide": "top" },
    { "from": "manual", "to": "failed", "variant": "security", "route": "straight", "fromSide": "bottom", "toSide": "top" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "4-Phase Step Lifecycle",
      "items": [
        "1. PREPARE: Records execution intent outbox entry in durable storage",
        "2. EXECUTE: Dispatches mutation carrying monotonic fencing token",
        "3. RECONCILE: Probes remote ground truth if network drop occurs",
        "4. VERIFY: Asserts target entity reached desired postcondition"
      ]
    },
    {
      "dot": "amber",
      "title": "Interruption & Approval",
      "items": [
        "High-risk workflow steps pause at APPROVAL_WAIT without blocking worker thread",
        "Revocation or denial transitions state cleanly to CANCELLED",
        "Automatic workflow resumption continues immediately upon signature receipt"
      ]
    },
    {
      "dot": "rose",
      "title": "Saga Compensation",
      "items": [
        "Compensable steps rollback in reverse dependency order",
        "Irreversible boundary (ESXi flash) transitions to MANUAL_HOLD if reconciliation fails",
        "Every terminal state emits a signed audit record before completion"
      ]
    }
  ]
