    {
      "dot": "emerald",
      "title": "Tasks Protocol Opt-In",
      "items": [
        "Task handles materialize only when client advertises io.modelcontextprotocol/tasks",
        "Calls without opt-in execute synchronously to prevent polling overhead",
        "tasks/list is removed per 2026-07-28 spec to block enumeration"
      ]
    },
    {
      "dot": "rose",
      "title": "Owner-Scoped Privacy",
      "items": [
        "tasks/get and tasks/cancel strictly enforce caller tenant and principal identity",
        "Task IDs use 24 bytes of high-entropy cryptographic randomness",
        "Cross-tenant task inspection returns -32601 or TaskNotFoundException"
      ]
    },
    {
      "dot": "cyan",
      "title": "SSE Push & Compensation",
      "items": [
        "Subscriptions/listen delivers real-time notifications/tasks/progress updates",
        "tasks/cancel triggers deterministic saga rollback for compensable steps",
        "Terminal cancellation states are permanently anchored in the audit log"
      ]
    }
