      "dot": "rose",
      "title": "Pattern 2: Gateway Cluster",
      "items": [
        "Stateless MCP protocol nodes deployed behind enterprise ALB / F5",
        "Mutual TLS (mTLS) and OAuth 2.0 Bearer tokens enforced at edge",
        "Dynamic routing with automatic node failure failover"
      ]
    },
